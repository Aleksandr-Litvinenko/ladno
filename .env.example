# Версия 0.1.0 не читает этот файл: демо работает только в браузере.
# Переменные зарезервированы для будущего SERVER-SIDE read-only коннектора.
# Не добавляйте OData-параметрам префиксы VITE_, NEXT_PUBLIC_ или PUBLIC_.

ODATA_BASE_URL=https://one-c.example.invalid/demo/odata/standard.odata
ODATA_USERNAME=change-me-on-server
ODATA_PASSWORD=change-me-on-server
ODATA_TIMEOUT_MS=10000
ODATA_READ_ONLY=true
ODATA_TLS_VERIFY=true
ODATA_ALLOWED_ENTITY_SETS=replace-me-on-server
